# Restreamer (local on VM)
RESTREAMER_URL=http://127.0.0.1:8080
RESTREAMER_USERNAME=admin
RESTREAMER_PASSWORD=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=eventcast-media
R2_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Supabase (for finalize-vod vod_link update)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Uploader behaviour
POLL_INTERVAL_MS=4000
MAX_RETRIES=5
DELETE_AFTER_UPLOAD=true
STATE_DIR=/var/lib/eventcast-uploader/state
DISK_WARN_PERCENT=75
DELETE_LOCAL_AFTER_FINALIZE=false
