{
  // Independent Cloudflare Workers configuration for the Admin app, used only
  // by the OpenNext (@opennextjs/cloudflare) build/preview path.
  //
  // DELIBERATELY NOT NAMED `wrangler.jsonc`.
  // The existing Cloudflare Pages build scans the project root for a default
  // Wrangler configuration file. While the Pages project is still the live
  // production path, introducing `wrangler.jsonc` here could change that
  // build's behavior. Every OpenNext/Wrangler command in this package
  // therefore passes `--config=wrangler.opennext.jsonc` explicitly, and no
  // default-named config may be generated.
  //
  // This is a NEW, independent Worker. It does not reuse, extend, or modify
  // `workers/render-event-page` or `workers/hls-signer`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eventcast-admin-worker",
  "main": ".open-next/worker.js",

  // Pinned. `nodejs_compat` is required by OpenNext; the Admin app runs on the
  // Node.js runtime, not the Edge runtime. `global_fetch_strictly_public`
  // makes fetches to our own public URLs leave the Worker as real public
  // requests rather than being routed back internally.
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Milestone O production cutover: `studio.eventcast.pro` is attached below
  // as a Cloudflare Workers Custom Domain — the supported mechanism for a
  // hostname with no prior DNS record on a zone this account controls.
  // `workers_dev` stays true so the `*.workers.dev` surface remains available
  // as a diagnostic/rollback path. `eventcast-admin.pages.dev` (Cloudflare
  // Pages) is deliberately untouched and remains the production fallback.
  "workers_dev": true,

  "routes": [
    { "pattern": "studio.eventcast.pro", "custom_domain": true }
  ],

  // Versioned preview URLs. `versions upload` prints a `Version Preview URL`
  // only when the upload response reports `metadata.has_preview`, and
  // Wrangler's default for `preview_urls` is undefined rather than true — so
  // the first upload produced no preview URL. With this set, each uploaded
  // version gets its own `https://<version-prefix>-<worker>.<subdomain>`
  // address, which is what allows the preview to be tested WITHOUT an active
  // deployment. This is not a trigger and does not route production traffic.
  "preview_urls": true,

  // Non-secret R2 identifiers the Admin app's own upload/delete/URL-validation
  // routes read via `process.env.*` (src/app/api/r2-upload, .../thumbnail,
  // .../media, .../guest-photos/{upload,delete}, src/lib/r2Delete.ts) — the
  // images/guest-photo bucket `eventcast-media`, distinct from the separate
  // media bucket the render Worker's own MEDIA_R2 binding reaches. None of
  // these three are secret: the bucket name and public replay URL are already
  // embedded in every stored `thumbnail_url`/R2 object URL, and the S3
  // endpoint is just `https://<account-id>.r2.cloudflarestorage.com` (the
  // same account id already unredacted in the now-retired legacy
  // scripts/vod-archiver/.env.example).
  // `R2_ACCESS_KEY_ID`/`R2_SECRET_ACCESS_KEY` remain real secrets and are
  // deliberately NOT here — they stay Worker secrets (`wrangler secret put`
  // / dashboard), never checked into this file.
  //
  // Declaring these as `vars` (rather than only setting them once via the
  // dashboard) is the durable fix for a real, recurring drift: `wrangler
  // versions upload` deletes any dashboard-only plain var whenever
  // `--keep-vars` isn't passed (confirmed via `wrangler versions upload
  // --help`; secrets are exempt from this deletion, plain vars are not).
  // These three were dashboard-only, got silently wiped this way once before
  // (fixed 2026-08-26, see WORKLOG.md) and were found wiped again on every
  // version uploaded since — because every one of those uploads read its var
  // set from this file, which had none. Putting them in the config makes
  // every future `versions upload` set them from source control automatically,
  // with no reliance on remembering `--keep-vars` for these three.
  "vars": {
    "R2_BUCKET_NAME": "eventcast-media",
    "R2_S3_ENDPOINT": "https://fa92fb66bb8615279773847f8aecae0c.r2.cloudflarestorage.com",
    "R2_PUBLIC_URL": "https://pub-fa013cc979d8410e9d307bd2c9e6ecf2.r2.dev"
  },

  // The only binding. `ASSETS` is required by OpenNext to serve the Next.js
  // static output; it is not an application-specific external resource.
  // No R2/KV/D1/Images or self-reference bindings are declared: the Admin app
  // reaches Supabase, R2, and B2 over the network using environment variables
  // only (the three non-secret R2 identifiers above, plus the R2 access
  // secrets and Supabase service-role key as Worker secrets), and the media
  // bucket remains reachable solely through the separate render Worker's own
  // MEDIA_R2 binding.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }
}
