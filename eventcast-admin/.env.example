# Copy to .env.local for local dev. Production: Cloudflare Pages env dashboard.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron (required for stream-health-monitor + sync-live-status)
CRON_SECRET=

# WhatsApp stream alerts (CallMeBot) — see docs/WHATSAPP_ALERTS_SETUP.md
ALERT_WHATSAPP_PHONE=+91XXXXXXXXXX
ALERT_WHATSAPP_APIKEY=
WHATSAPP_ALERT_COOLDOWN_MINUTES=30
ADMIN_PUBLIC_URL=https://eventcast-admin.pages.dev

# YouTube Live (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Media Agent control plane (internal/operator-only routes)
MEDIA_NODE_TOKEN_PEPPER=
MEDIA_NODE_PROVISIONING_SECRET=

# Optional
STREAM_BITRATE_THRESHOLD_KBPS=300
NEXT_PUBLIC_GEMINI_API_KEY=
