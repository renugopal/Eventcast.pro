  <body><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>✨ Shaik Mubeena Roshini &amp; Tummalagodu Ameer Basha | Nikah Ceremony Live</title><meta name="description" content="Join us online to witness and bless the Nikah Ceremony of Shaik Mubeena Roshini &amp; Tummalagodu Ameer Basha live from Guntur."/><meta property="og:title" content="✨ Shaik Mubeena Roshini &amp; Tummalagodu Ameer Basha | Nikah Ceremony Live"/><meta property="og:description" content="Join us online to witness and bless the Nikah Ceremony of Shaik Mubeena Roshini &amp; Tummalagodu Ameer Basha live from Guntur."/><meta property="og:image" content="Template.webp"/><meta property="og:type" content="website"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/><link href="https://fonts.googleapis.com/css2?family=Amiri:ital@0;1&amp;family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&amp;family=Marcellus&amp;family=Inter:wght@300;400;500;600&amp;display=swap" rel="stylesheet"/><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/><link rel="stylesheet" href="style.css"/><div id="iwnm" class="desktop-bg-blur"></div><div id="ii2qo" class="app-container"><!-- Main Invitation Card --><div class="invitation-card"><!-- HERO SECTION --><section id="hero" class="hero-section"><!-- Overlay Elements mapped on Template.webp background --><div class="hero-content"><!-- Top Live Badge --><div id="top-live-badge" class="top-live-badge"><span class="live-dot"></span><span id="top-live-text" class="live-text">LIVE EVENT STREAMING</span></div><!-- Bride Name --><h1 id="ifj49" class="bride-name-overlay">Mubeena</h1><!-- Groom Name --><h1 id="i4t7s" class="groom-name-overlay">Ameer Basha</h1><!-- Nikah Ceremony Text (placed inside the printed gold flourishes) --><h2 id="ivxuo" class="nikah-ceremony-overlay">Nikah Ceremony</h2><!-- Monogram Overlay to cover "A â™¥ A" inside the printed shield --><div id="monogram-id" class="monogram-overlay">M ♥ A</div><div id="i05ra" class="details-card"><div class="details-grid"><!-- Date Column --><div class="detail-item"><div class="icon-circle"><i class="fa-regular fa-calendar-days"></i></div><span class="detail-label">DATE</span><span class="detail-value">Friday</span><span class="detail-subvalue">05 June 2026</span></div><!-- Divider --><div class="vertical-divider"><span class="divider-dot"></span></div><!-- Time Column --><div class="detail-item"><div class="icon-circle"><i class="fa-regular fa-clock"></i></div><span class="detail-label">TIME</span><span class="detail-value">10:30 AM</span><span class="detail-subvalue">Onwards</span></div><!-- Divider --><div class="vertical-divider"><span class="divider-dot"></span></div><!-- Venue Column --><div id="ilx7p" class="detail-item"><div class="icon-circle"><i class="fa-solid fa-location-dot"></i></div><span class="detail-label">VENUE</span><span class="detail-value">ASR Convention</span><span class="detail-subvalue">Guntur</span></div></div></div><!-- Countdown Box (Dark Green matching mockup) --><div id="isphc" class="countdown-card"><div id="i6puj" class="countdown-header"><span class="countdown-title">â†  EVENT STARTS IN â†ž</span></div><div id="countdown" class="countdown-grid"><div class="time-unit"><span id="days" class="time-num">00</span><span class="time-label">DAYS</span></div><div class="countdown-divider"></div><div class="time-unit"><span id="hours" class="time-num">00</span><span class="time-label">HOURS</span></div><div class="countdown-divider"></div><div class="time-unit"><span id="minutes" class="time-num">00</span><span class="time-label">MINUTES</span></div><div class="countdown-divider"></div><div class="time-unit"><span id="seconds" class="time-num">00</span><span class="time-label">SECONDS</span></div></div><!-- Mosque Silhouette SVG Outline --></div><!-- Add to Calendar Button --><div id="i6n16r" class="calendar-btn-wrapper"><button id="add-to-calendar-btn" class="calendar-btn"><span class="btn-decor-left">✣</span><i class="fa-regular fa-calendar-check calendar-icon"></i><span>ADD TO CALENDAR</span><span class="btn-decor-right">✣</span></button></div></div></section><!-- LIVESTREAM SECTION --><section id="livestream" class="livestream-section"><div class="section-divider"></div><div class="section-header"><h3 class="section-title">LIVE STREAM</h3><div class="status-badge"><span class="pulse-dot"></span> LIVE SOON</div></div><!-- Video Player Container --><div class="video-card"><div class="video-ratio-box"><!-- Replace Youtube Link when ready --><iframe allowfullscreen="" src="https://www.youtube.com/embed/L_iYJZS9PG0?&amp;rel=0&amp;modestbranding=1" title="Nikah Ceremony Live Stream" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></div><!-- Address Details Card for physical guests --><div class="venue-info-card"><h4 class="venue-title"><i class="fa-solid fa-location-dot"></i> Venue Address</h4><p class="venue-address">
