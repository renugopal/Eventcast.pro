# EventCast Media Node Compose stack - Phase 0 skeleton configuration.
#
# Copy to .env for local use only. Never commit a real .env file.
# Both variables are non-secret operational settings consumed by the
# Media Agent container (see ../../../services/media-agent/.env.example).

# Unique, non-secret identifier for this media node.
EVENTCAST_NODE_ID=media-node-staging-01

# One of: debug, info, warn, error.
EVENTCAST_LOG_LEVEL=info
