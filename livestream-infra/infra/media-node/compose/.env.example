# EventCast Media Node Compose stack configuration.
#
# Copy to .env for local use only. Never commit a real .env file.
# All variables below are non-secret operational settings consumed by
# the Media Agent container (see ../../../services/media-agent/.env.example).

# Unique, non-secret identifier for this media node.
EVENTCAST_NODE_ID=media-node-staging-01

# One of: debug, info, warn, error.
EVENTCAST_LOG_LEVEL=info

# How often the Media Agent's periodic reconciliation pass runs.
EVENTCAST_RECONCILE_INTERVAL=30s

# Max time an active ingest session may lack segment activity before
# reconciliation marks it disconnected, freeing its event for a new
# publisher after an ungraceful disconnect.
EVENTCAST_SESSION_STALE_TIMEOUT=180s

# SQLite busy_timeout.
EVENTCAST_DB_BUSY_TIMEOUT=5s

# Optional: absolute host directory containing an assignments.json seed
# file, bind-mounted read-only into the container at
# /var/lib/eventcast/config. Leave unset to use the default
# (/opt/eventcast/media-node/config/assignments, auto-created empty if
# absent). Combine with EVENTCAST_ASSIGNMENT_SEED_PATH below to actually
# enable seeding.
# ASSIGNMENT_SEED_HOST_DIR=/opt/eventcast/media-node/config/assignments

# Optional: container-internal path to the seed file within the mount
# above. Leave unset (the default) to start with an empty assignment
# cache - every publish is rejected as ASSIGNMENT_MISMATCH until this is
# configured.
# EVENTCAST_ASSIGNMENT_SEED_PATH=/var/lib/eventcast/config/assignments.json

# Dev/test-only opt-in. Leave unset (the default, false) in every real
# deployment: any seed-file row with enabled: true is otherwise forced to
# disabled at import, so a local seed file alone can never authorize a real
# publish - only an operator-activated assignment from the control plane
# can. Set true only for isolated dev/test fixtures that intentionally seed
# an already-enabled assignment to exercise on_publish without a control
# plane (e.g. this directory's own integration test scripts).
# EVENTCAST_ALLOW_SEED_ENABLED_ASSIGNMENTS=false

# Control-plane assignment synchronization (internal/controlplane).
# Leave EVENTCAST_CONTROLPLANE_BASE_URL unset to disable continuous sync
# and rely solely on the seed file above (the safe default for local/dev
# use). Setting it requires EVENTCAST_CONTROLPLANE_NODE_TOKEN.
# EVENTCAST_CONTROLPLANE_BASE_URL=https://control.eventcast.pro
# EVENTCAST_CONTROLPLANE_NODE_TOKEN=
EVENTCAST_CONTROLPLANE_REQUEST_TIMEOUT=10s
EVENTCAST_CONTROLPLANE_SYNC_INTERVAL=30s
EVENTCAST_CONTROLPLANE_BACKOFF_BASE=2s
EVENTCAST_CONTROLPLANE_BACKOFF_MAX=5m
EVENTCAST_CONTROLPLANE_STALE_WARN_AFTER=5m
EVENTCAST_CONTROLPLANE_STALE_CRITICAL_AFTER=20m

# Backblaze B2 authoritative VOD archival.
#
# Variable NAMES only - never commit a real value for any of these. The
# real credentials belong in this node's own uncommitted .env, entered
# directly on the host.
#
# Two deliberately separate concepts:
#   * configuration presence - the five variables below being set and valid
#   * archival enablement    - EVENTCAST_B2_ARCHIVE_ENABLED
#
# A node may hold a complete, valid B2 configuration purely so the isolated
# `_connectivity-test/...` probe can be run under explicit approval, while
# archival of real event recordings stays off. Setting
# EVENTCAST_B2_ARCHIVE_ENABLED=true without a complete configuration is a
# startup error rather than a silently disabled subsystem.
#
# There is no default region: unlike R2's "auto", Backblaze's S3 endpoint
# is region-bound and its signature is region-specific.
#
# Note the retention interaction: once archival is enabled, a finalized
# event's local spool copies are retained until that event's archive is
# complete, acknowledged, and strongly verified - the spool is the
# archiver's only byte source, so the 24-hour delay alone is no longer
# sufficient to release it.
# EVENTCAST_B2_ENDPOINT=
# EVENTCAST_B2_REGION=
# EVENTCAST_B2_BUCKET=
# EVENTCAST_B2_ACCESS_KEY_ID=
# EVENTCAST_B2_SECRET_ACCESS_KEY=
# EVENTCAST_B2_OBJECT_PREFIX=
EVENTCAST_B2_ARCHIVE_ENABLED=false
EVENTCAST_B2_REQUEST_TIMEOUT=60s
EVENTCAST_B2_RETRY_BASE_DELAY=1s
EVENTCAST_B2_RETRY_MAX_DELAY=60s
EVENTCAST_B2_ARCHIVE_INTERVAL=30s
EVENTCAST_B2_REPORT_INTERVAL=30s
# Must stay false in production; exists only for isolated tests against a
# local S3-compatible container with a self-signed certificate.
EVENTCAST_B2_INSECURE_SKIP_VERIFY=false

# Authenticates POST/GET .../finalize and .../vod-gap (internal/operatorauth).
# Leave unset only for local development; production must set this.
# EVENTCAST_OPERATOR_API_TOKEN=

# Rate limiting (internal/ratelimit) applied to SRS callbacks and the
# operator endpoints above.
EVENTCAST_RATE_LIMIT_RPS=20
EVENTCAST_RATE_LIMIT_BURST=40
# Must stay false unless a trusted reverse proxy this deployment controls
# sits in front of this agent and strips any client-supplied
# X-Forwarded-For before setting its own.
EVENTCAST_TRUSTED_PROXY_ENABLED=false
