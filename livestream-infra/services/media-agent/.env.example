# EventCast Media Agent configuration (v1.2 ingest control and durability)
#
# Copy to .env for local use only. Never commit a real .env file.
# None of these variables are secret-bearing; the one credential-shaped
# value (the assignment seed file) stores only a SHA-256 hash of each
# stream's secret token, never the raw secret.

# Unique, non-secret identifier for this media node. Allowed characters:
# ASCII letters, digits, '.', '_', '-' (maximum 128 characters).
EVENTCAST_NODE_ID=media-node-local-dev

# Address the Media Agent HTTP server binds to. The port must be an
# explicit number between 1 and 65535. Must stay loopback-only unless
# the deployment topology explicitly requires otherwise (see
# 02_V1_ARCHITECTURE_SPEC.md: internal callback endpoints MUST bind to
# loopback or a private network only).
EVENTCAST_MEDIA_AGENT_HTTP_ADDR=127.0.0.1:8085

# One of: debug, info, warn, error.
EVENTCAST_LOG_LEVEL=info

# Absolute path to the SQLite WAL-backed durable database file
# (assignment cache, ingest sessions, segment queue). Must be on
# persistent storage, not a container writable layer or tmpfs.
EVENTCAST_DB_PATH=/var/lib/eventcast/db/media-agent.sqlite3

# Absolute path to the Media Agent's protected durable spool root. Must
# be a distinct, non-nested path from EVENTCAST_SRS_HLS_ROOT.
EVENTCAST_SPOOL_ROOT=/var/lib/eventcast/spool

# Absolute path to the SRS HLS staging root. on_hls callback file paths
# must resolve inside this root; anything outside it is rejected.
# SHOULD be on the same filesystem as EVENTCAST_SPOOL_ROOT so completed
# segments can be hard-linked rather than copied.
EVENTCAST_SRS_HLS_ROOT=/var/lib/eventcast/srs-output

# Optional absolute path to a JSON seed file of cached event
# assignments, imported once at startup. Leave unset to start with an
# empty cache (every publish is rejected as ASSIGNMENT_MISMATCH until
# seeded) - the safe default until a later milestone's control-plane
# client keeps this cache continuously synchronized instead.
EVENTCAST_ASSIGNMENT_SEED_PATH=

# How often periodic reconciliation runs (spool/queue recovery, stale
# session detection, bounded temp-file cleanup). Any positive Go
# duration; defaults to 30s.
EVENTCAST_RECONCILE_INTERVAL=30s

# Maximum time an ingest session may remain active with no segment
# activity before periodic reconciliation marks it disconnected,
# freeing its event for a new publisher after an ungraceful disconnect
# that never produced an on_unpublish callback. Defaults to 180s.
EVENTCAST_SESSION_STALE_TIMEOUT=180s

# SQLite busy_timeout: how long a writer waits for a lock before
# failing. Defaults to 5s.
EVENTCAST_DB_BUSY_TIMEOUT=5s
