# EventCast Media Agent configuration (v1.2 media delivery, DVR/VOD, and relay)
#
# Copy to .env for local use only. Never commit a real .env file.
# EVENTCAST_R2_SECRET_ACCESS_KEY is the only secret-bearing variable
# below; the assignment seed file stores only a SHA-256 hash of each
# stream's secret token (never the raw secret) plus, optionally, the raw
# YouTube stream key - see README.md "YouTube relay authorization".

# Unique, non-secret identifier for this media node. Allowed characters:
# ASCII letters, digits, '.', '_', '-' (maximum 128 characters).
EVENTCAST_NODE_ID=media-node-local-dev

# Address the Media Agent HTTP server binds to. The port must be an
# explicit number between 1 and 65535. Must stay loopback-only unless
# the deployment topology explicitly requires otherwise (see
# 02_V1_ARCHITECTURE_SPEC.md: internal callback endpoints MUST bind to
# loopback or a private network only).
EVENTCAST_MEDIA_AGENT_HTTP_ADDR=127.0.0.1:8085

# One of: debug, info, warn, error.
EVENTCAST_LOG_LEVEL=info

# Absolute path to the SQLite WAL-backed durable database file
# (assignment cache, ingest sessions, segment queue). Must be on
# persistent storage, not a container writable layer or tmpfs.
EVENTCAST_DB_PATH=/var/lib/eventcast/db/media-agent.sqlite3

# Absolute path to the Media Agent's protected durable spool root. Must
# be a distinct, non-nested path from EVENTCAST_SRS_HLS_ROOT.
EVENTCAST_SPOOL_ROOT=/var/lib/eventcast/spool

# Absolute path to the SRS HLS staging root. on_hls callback file paths
# must resolve inside this root; anything outside it is rejected.
# SHOULD be on the same filesystem as EVENTCAST_SPOOL_ROOT so completed
# segments can be hard-linked rather than copied.
EVENTCAST_SRS_HLS_ROOT=/var/lib/eventcast/srs-output

# Optional absolute path to a JSON seed file of cached event
# assignments, imported once at startup. Leave unset to start with an
# empty cache (every publish is rejected as ASSIGNMENT_MISMATCH until
# seeded) - the safe default until a later milestone's control-plane
# client keeps this cache continuously synchronized instead.
EVENTCAST_ASSIGNMENT_SEED_PATH=

# How often periodic reconciliation runs (spool/queue recovery, stale
# session detection, bounded temp-file cleanup). Any positive Go
# duration; defaults to 30s.
EVENTCAST_RECONCILE_INTERVAL=30s

# Maximum time an ingest session may remain active with no segment
# activity before periodic reconciliation marks it disconnected,
# freeing its event for a new publisher after an ungraceful disconnect
# that never produced an on_unpublish callback. Defaults to 180s.
EVENTCAST_SESSION_STALE_TIMEOUT=180s

# SQLite busy_timeout: how long a writer waits for a lock before
# failing. Defaults to 5s.
EVENTCAST_DB_BUSY_TIMEOUT=5s

# R2 (or any S3-compatible endpoint, e.g. a local MinIO for
# development). Leaving EVENTCAST_R2_BUCKET empty disables the entire
# upload/manifest/VOD/retention subsystem (a startup warning is
# logged); setting it requires the endpoint/access-key/secret below.
EVENTCAST_R2_ENDPOINT=
EVENTCAST_R2_REGION=auto
EVENTCAST_R2_BUCKET=
EVENTCAST_R2_ACCESS_KEY_ID=
EVENTCAST_R2_SECRET_ACCESS_KEY=
EVENTCAST_R2_OBJECT_PREFIX=
EVENTCAST_R2_PUBLIC_BASE_URL=
EVENTCAST_R2_UPLOAD_CONCURRENCY=4
EVENTCAST_R2_RETRY_BASE_DELAY=500ms
EVENTCAST_R2_RETRY_MAX_DELAY=30s
EVENTCAST_R2_REQUEST_TIMEOUT=20s
EVENTCAST_R2_UPLOAD_LEASE_DURATION=30s
# Must stay false in production; only for local test endpoints with a
# self-signed certificate.
EVENTCAST_R2_INSECURE_SKIP_VERIFY=false

# Live/DVR manifest window (ADR-004: ~900s / 15 minutes). Do not change
# the production default without a new decision record.
EVENTCAST_DVR_WINDOW=900s

# How long after VOD finalization a confirmed segment's local spool
# copy remains before the retention worker deletes it.
EVENTCAST_LOCAL_RETENTION_DELAY=24h

# Periodic backstop live-manifest rebuild sweep interval and retention
# worker sweep interval.
EVENTCAST_MANIFEST_REBUILD_INTERVAL=5s
EVENTCAST_CLEANUP_INTERVAL=15m

# YouTube relay process supervision. Per-event authorization (enabled
# flag, destination, stream key) comes from the assignment seed file,
# not these variables - see README.md "YouTube relay authorization".
EVENTCAST_YOUTUBE_FFMPEG_PATH=ffmpeg
EVENTCAST_YOUTUBE_RESTART_MAX_ATTEMPTS=5
EVENTCAST_YOUTUBE_RESTART_BACKOFF_BASE=2s
EVENTCAST_YOUTUBE_RESTART_BACKOFF_MAX=60s
# This node's own SRS RTMP endpoint the relay pulls from - never a
# public address.
EVENTCAST_YOUTUBE_SOURCE_RTMP_BASE_URL=rtmp://127.0.0.1:1935

# Control-plane assignment synchronization (internal/controlplane).
# Leaving EVENTCAST_CONTROLPLANE_BASE_URL empty disables continuous sync;
# the agent then relies solely on EVENTCAST_ASSIGNMENT_SEED_PATH above
# (the same behavior as before this milestone). Setting it requires
# EVENTCAST_CONTROLPLANE_NODE_TOKEN.
EVENTCAST_CONTROLPLANE_BASE_URL=
EVENTCAST_CONTROLPLANE_NODE_TOKEN=
EVENTCAST_CONTROLPLANE_REQUEST_TIMEOUT=10s
EVENTCAST_CONTROLPLANE_SYNC_INTERVAL=30s
EVENTCAST_CONTROLPLANE_BACKOFF_BASE=2s
EVENTCAST_CONTROLPLANE_BACKOFF_MAX=5m
EVENTCAST_CONTROLPLANE_STALE_WARN_AFTER=5m
EVENTCAST_CONTROLPLANE_STALE_CRITICAL_AFTER=20m

# Authenticates POST/GET .../finalize and .../vod-gap
# (internal/operatorauth). Empty leaves those endpoints unauthenticated
# (a startup warning is logged); production must set this.
EVENTCAST_OPERATOR_API_TOKEN=

# Rate limiting and abuse protection (internal/ratelimit), applied to
# SRS callbacks and the operator endpoints.
EVENTCAST_RATE_LIMIT_RPS=20
EVENTCAST_RATE_LIMIT_BURST=40
# Must stay false unless a trusted reverse proxy this deployment controls
# sits in front of this agent and strips any client-supplied
# X-Forwarded-For before setting its own (02_V1_ARCHITECTURE_SPEC.md
# "Security requirements").
EVENTCAST_TRUSTED_PROXY_ENABLED=false
